.login-page {
    min-height: 100vh;
    padding: 72rpx 32rpx 48rpx;
    background: #F7F8FA;
}

.login {
    padding: 36rpx 32rpx;
    background: #ffffff;
    border-radius: 28rpx;
    box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}

.login-title {
    display: block;
    font-size: 34rpx;
    font-weight: 700;
    color: #1E293B;
}

.login-desc {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #64748B;
}

.login-label {
    display: block;
    margin-top: 30rpx;
    font-size: 24rpx;
    font-weight: 600;
    color: #475569;
}

.login-input {
    height: 80rpx;
    padding: 0 24rpx;
    margin-top: 18rpx;
    font-size: 28rpx;
    color: #1E293B;
    background: #f4f6fb;
    border-radius: 18rpx;
}

.login-placeholder {
    color: #94A3B8;
}

.login-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}

.login-code {
    flex: 1;
    margin-top: 20rpx;
}

.login-send {
    flex-shrink: 0;
    margin: 20rpx 0 0 0;
    padding: 0 24rpx;
    height: 80rpx;
    line-height: 80rpx;
    font-size: 26rpx;
    color: #2554A8;
    background: #F2F5FA;
    border-radius: 18rpx;
}

.login-send-disabled {
    color: #94A3B8;
    background: #f4f6fb;
}

.login-hint {
    flex: 1;
    min-width: 320rpx;
    margin: 20rpx 0 0 20rpx;
    font-size: 20rpx;
    line-height: 1.5;
    color: #64748B;
}

.login-tabs {
    display: flex;
    margin-top: 32rpx;
    border-bottom: 2rpx solid #F0F2F5;
}

.login-tab {
    flex: 1;
    padding: 18rpx 0;
    text-align: center;
    font-size: 27rpx;
    color: #64748B;
    border-bottom: 4rpx solid transparent;
}

.login-tab-active {
    color: #2554A8;
    font-weight: 700;
    border-bottom-color: #2554A8;
}

.login-button {
    margin-top: 32rpx;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: #2554A8;
    border-radius: 18rpx;
}

.login-button::after {
    border: none;
}

/* 微信一键登录：平台色作为动作识别，形状与品牌按钮保持一致 */
.login-button-wechat {
    margin-top: 36rpx;
    background: #07C160;
}

.login-divider {
    display: flex;
    align-items: center;
    margin: 30rpx 0 4rpx;
}

.login-divider-line {
    flex: 1;
    height: 1rpx;
    background: #E2E8F0;
}

.login-divider-text {
    padding: 0 20rpx;
    font-size: 24rpx;
    color: #94A3B8;
}

.login-tip {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #17a673;
}

.login-error {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #e5484d;
}
