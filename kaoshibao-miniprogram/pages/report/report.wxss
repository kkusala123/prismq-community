.report-wrap {
    padding-bottom: 60rpx;
}

.score-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 32rpx 34rpx;
    border-radius: 24rpx;
    color: #ffffff;
}

.card-pass {
    background: linear-gradient(150deg, #12B76A 0%, #2ED08B 100%);
    box-shadow: 0 12rpx 32rpx rgba(18, 183, 106, 0.24);
}

.card-fail {
    background: linear-gradient(150deg, #F56C6C 0%, #FF9A8B 100%);
    box-shadow: 0 12rpx 32rpx rgba(245, 108, 108, 0.24);
}

.score-exam {
    color: rgba(255, 255, 255, 0.9);
    font-size: 24rpx;
}

.score-main {
    display: flex;
    align-items: flex-end;
    margin-top: 16rpx;
}

.score-number {
    font-size: 92rpx;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -2rpx;
    font-variant-numeric: tabular-nums;
}

.score-total {
    margin-bottom: 10rpx;
    margin-left: 10rpx;
    color: rgba(255, 255, 255, 0.82);
    font-size: 28rpx;
}

.pass-badge {
    margin-top: 18rpx;
    padding: 8rpx 26rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.22);
    font-size: 24rpx;
    font-weight: 700;
}

.score-line {
    margin-top: 12rpx;
    color: rgba(255, 255, 255, 0.8);
    font-size: 22rpx;
}

/* 指标 */
.metric-card {
    display: flex;
    margin-top: 22rpx;
    padding: 26rpx 0;
}

.metric-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    border-right: 2rpx solid #F0F2F5;
}

.metric-item:last-child {
    border-right: none;
}

.metric-value {
    color: #1E293B;
    font-size: 30rpx;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
}

.metric-label {
    margin-top: 4rpx;
    color: #64748B;
    font-size: 20rpx;
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 34rpx 4rpx 18rpx;
}

/* 逐题 */
.item-card {
    margin-bottom: 18rpx;
    padding: 26rpx;
}

.item-head {
    display: flex;
    align-items: center;
}

.item-no {
    display: flex;
    width: 44rpx;
    height: 44rpx;
    align-items: center;
    justify-content: center;
    margin-right: 12rpx;
    border-radius: 50%;
    background: #F0F2F5;
    color: #475569;
    font-size: 22rpx;
    font-weight: 700;
}

.item-verdict {
    font-size: 23rpx;
    font-weight: 700;
}

.verdict-right {
    color: #12B76A;
}

.verdict-wrong {
    color: #F56C6C;
}

.item-stem {
    display: block;
    margin-top: 16rpx;
    color: #1E293B;
    font-size: 27rpx;
    font-weight: 600;
    line-height: 1.65;
}

.item-answers {
    margin-top: 18rpx;
    padding: 18rpx;
    border-radius: 12rpx;
    background: #F8FAFC;
}

.answer-line {
    display: flex;
    align-items: flex-start;
}

.answer-line + .answer-line {
    margin-top: 10rpx;
}

.answer-label {
    width: 130rpx;
    flex-shrink: 0;
    color: #64748B;
    font-size: 23rpx;
}

.answer-value {
    flex: 1;
    font-size: 25rpx;
    font-weight: 600;
    word-break: break-all;
}

.value-right {
    color: #12B76A;
}

.value-wrong {
    color: #F56C6C;
}

.explain-block {
    margin-top: 18rpx;
    padding: 20rpx;
    border-radius: 12rpx;
    background: #F8FAFC;
}

.explain-label {
    display: block;
    margin-bottom: 8rpx;
    color: #2554A8;
    font-size: 22rpx;
    font-weight: 700;
}

.explain-text {
    color: #475569;
    font-size: 24rpx;
    line-height: 1.75;
}

.empty-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48rpx;
}

.action-row {
    display: flex;
    margin-top: 34rpx;
}

.action-row .btn {
    flex: 1;
}

.action-row .btn + .btn {
    margin-left: 18rpx;
}

/* AI 一键解析 */
.ai-actions {
    display: flex;
    margin-top: 18rpx;
}

.ai-btn {
    flex: 1;
    height: 68rpx;
    line-height: 68rpx;
    font-size: 24rpx;
    border-radius: 14rpx;
}

.ai-error {
    margin-top: 12rpx;
    padding: 12rpx 16rpx;
    border-radius: 12rpx;
    background: #FEF2F2;
    color: #DC2626;
    font-size: 23rpx;
}

.ai-box {
    margin-top: 16rpx;
    padding: 20rpx;
    border-radius: 14rpx;
    border: 2rpx solid #C7D2FE;
    background: #EEF2FF;
}

.ai-box-head {
    display: block;
    margin-bottom: 10rpx;
    color: #3730A3;
    font-size: 23rpx;
    font-weight: 700;
}

.ai-field + .ai-field {
    margin-top: 10rpx;
}

.ai-field-lbl {
    color: #1E293B;
    font-size: 23rpx;
    font-weight: 700;
}

.ai-field-val {
    color: #334155;
    font-size: 23rpx;
    line-height: 1.65;
}

.ai-mnemonic {
    margin-top: 12rpx;
    padding: 12rpx 16rpx;
    border-radius: 10rpx;
    background: rgba(255, 255, 255, 0.85);
}
