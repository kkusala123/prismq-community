.practice-page {
    min-height: 100vh;
    padding: 20rpx 28rpx 220rpx;
    background: #F7F8FA;
}

/* 顶部进度 */
.topbar {
    padding: 18rpx 24rpx 20rpx;
    border-radius: 16rpx;
    background: #ffffff;
}

.topbar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14rpx;
}

.mode-label {
    color: #007AFF;
    font-size: 24rpx;
    font-weight: 700;
}

.progress-text {
    color: #475569;
    font-size: 24rpx;
    font-variant-numeric: tabular-nums;
}

.topbar-track {
    height: 8rpx;
}

/* ---------- 左右滑动切题 ----------
   swipe-wrap 只做手势容器，swipe-inner 承担位移与淡入。
   位移控制在 24rpx 以内（小于页面左右 28rpx 的留白），
   这样动画期间不会把内容顶出屏幕、也不会产生横向滚动条。 */
.swipe-wrap {
    position: relative;
}

.swipe-inner {
    /* 120fps 高刷硬件合成优化：独立布局边界 + GPU transform */
    will-change: transform, opacity;
    backface-visibility: hidden;
    contain: layout style;
}

.swipe-inner.slide-next {
    animation: slideInNext 180ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.swipe-inner.slide-prev {
    animation: slideInPrev 180ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.sort-bar {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-top: 14rpx;
}

.sort-pill {
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    font-weight: 600;
    color: #64748B;
    background: #F1F5F9;
}

.sort-pill-active {
    color: #ffffff;
    background: #007AFF;
}

.sort-pill-reset {
    color: #DC2626;
    background: #FEF2F2;
}

@keyframes slideInNext {
    from {
        opacity: 0.4;
        transform: translate3d(24rpx, 0, 0);
    }
    to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }
}

@keyframes slideInPrev {
    from {
        opacity: 0.4;
        transform: translate3d(-24rpx, 0, 0);
    }
    to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }
}

/* 题干 */
.question-card {
    margin-top: 20rpx;
    padding: 30rpx 28rpx 34rpx;
}

.q-head {
    display: flex;
    align-items: center;
}

.q-tip {
    margin-left: 8rpx;
    color: #64748B;
    font-size: 22rpx;
}

.fav-btn {
    display: flex;
    align-items: center;
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    background: #F5F7FA;
}

.fav-on {
    background: #FDF6EC;
}

.fav-icon {
    color: #CBD5E1;
    font-size: 26rpx;
}

.fav-on .fav-icon {
    color: #E6A23C;
}

.fav-text {
    margin-left: 6rpx;
    color: #64748B;
    font-size: 21rpx;
}

.fav-on .fav-text {
    color: #E6A23C;
}

.q-stem {
    display: block;
    margin-top: 22rpx;
    color: #1C1C1E;
    font-size: 31rpx;
    font-weight: 600;
    line-height: 1.7;
}

/* 选项 */
.options {
    margin-top: 26rpx;
}

.option {
    display: flex;
    align-items: flex-start;
    margin-bottom: 18rpx;
    padding: 24rpx 22rpx;
    border: 2rpx solid #E4E7ED;
    border-radius: 16rpx;
    background: #FAFBFC;
}

.opt-selected {
    border-color: #007AFF;
    background: #EAF3FF;
}

.opt-correct {
    border-color: #12B76A;
    background: #ECFDF3;
}

.opt-wrong {
    border-color: #F56C6C;
    background: #FEF0F0;
}

.opt-key {
    display: flex;
    width: 52rpx;
    height: 52rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #F0F2F5;
    color: #475569;
    font-size: 25rpx;
    font-weight: 700;
}

.opt-key-selected {
    background: #007AFF;
    color: #ffffff;
}

.opt-key-correct {
    background: #12B76A;
    color: #ffffff;
}

.opt-key-wrong {
    background: #F56C6C;
    color: #ffffff;
}

.opt-content {
    flex: 1;
    margin-left: 18rpx;
    padding-top: 6rpx;
    color: #1C1C1E;
    font-size: 27rpx;
    line-height: 1.6;
}

.opt-mark {
    margin-left: 12rpx;
    padding-top: 6rpx;
    font-size: 26rpx;
    font-weight: 700;
}

.mark-right {
    color: #12B76A;
}

.mark-wrong {
    color: #F56C6C;
}

/* 填空 */
.fill-area {
    margin-top: 26rpx;
}

.fill-input {
    height: 92rpx;
    padding: 0 24rpx;
    border: 2rpx solid #E4E7ED;
    border-radius: 14rpx;
    background: #FAFBFC;
    color: #1C1C1E;
    font-size: 28rpx;
}

.short-input {
    width: 100%;
    height: 220rpx;
    padding: 22rpx 24rpx;
    border: 2rpx solid #E4E7ED;
    border-radius: 14rpx;
    background: #FAFBFC;
    color: #1C1C1E;
    font-size: 27rpx;
    line-height: 1.6;
}

.multi-submit {
    margin-top: 26rpx;
}

/* 解析 */
.answer-card {
    margin-top: 20rpx;
    padding: 28rpx;
}

.answer-head {
    display: flex;
    align-items: center;
    margin-bottom: 22rpx;
}

.verdict {
    padding: 8rpx 20rpx;
    border-radius: 10rpx;
    font-size: 24rpx;
    font-weight: 700;
}

.verdict-right {
    background: #ECFDF3;
    color: #12B76A;
}

.verdict-wrong {
    background: #FEF0F0;
    color: #F56C6C;
}

.verdict-recite {
    background: #EAF3FF;
    color: #007AFF;
}

.answer-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 14rpx;
}

.answer-label {
    width: 130rpx;
    flex-shrink: 0;
    color: #64748B;
    font-size: 24rpx;
}

.answer-value {
    flex: 1;
    color: #12B76A;
    font-size: 27rpx;
    font-weight: 700;
    word-break: break-all;
}

.answer-user {
    color: #475569;
}

.explain-block {
    margin-top: 20rpx;
    padding: 22rpx;
    border-radius: 12rpx;
    background: #F8FAFC;
}

.explain-label {
    display: block;
    margin-bottom: 8rpx;
    color: #007AFF;
    font-size: 23rpx;
    font-weight: 700;
}

.explain-text {
    color: #475569;
    font-size: 25rpx;
    line-height: 1.75;
}

/* 底部栏 */
.practice-bar {
    display: flex;
    align-items: center;
}

.bar-btn {
    flex: 1;
    height: 84rpx;
    font-size: 27rpx;
}

.bar-btn + .bar-btn {
    margin-left: 16rpx;
}

/* 答题卡 */
.mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    display: flex;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.42);
}

.card-panel {
    width: 100%;
    max-height: 78vh;
    padding: 34rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
    border-radius: 28rpx 28rpx 0 0;
    background: #ffffff;
}

.card-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-close {
    padding: 8rpx 12rpx;
    color: #64748B;
    font-size: 30rpx;
}

.card-legend {
    display: flex;
    margin-top: 22rpx;
}

.legend-item {
    display: flex;
    align-items: center;
    margin-right: 28rpx;
}

.legend-dot {
    width: 18rpx;
    height: 18rpx;
    border-radius: 50%;
}

.dot-right {
    background: #12B76A;
}

.dot-wrong {
    background: #F56C6C;
}

.dot-todo {
    background: #E4E7ED;
}

.legend-text {
    margin-left: 8rpx;
    color: #475569;
    font-size: 22rpx;
}

.card-grid-scroll {
    max-height: 46vh;
    margin-top: 24rpx;
}

.card-grid {
    display: flex;
    flex-wrap: wrap;
}

.card-cell {
    display: flex;
    width: 76rpx;
    height: 76rpx;
    align-items: center;
    justify-content: center;
    margin: 0 16rpx 16rpx 0;
    border: 2rpx solid #E4E7ED;
    border-radius: 14rpx;
    background: #FAFBFC;
    color: #475569;
    font-size: 26rpx;
    font-weight: 600;
}

.cell-right {
    border-color: #12B76A;
    background: #ECFDF3;
    color: #12B76A;
}

.cell-wrong {
    border-color: #F56C6C;
    background: #FEF0F0;
    color: #F56C6C;
}

.cell-current {
    border-color: #007AFF;
    background: #007AFF;
    color: #ffffff;
}

.ph {
    color: #CBD5E1;
}

.finish-modal {
    width: 620rpx;
    padding: 44rpx 36rpx 36rpx;
    border-radius: 28rpx;
    background: #ffffff;
    box-sizing: border-box;
    text-align: center;
}

.finish-badge {
    display: inline-block;
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    background: #ECFDF3;
    color: #12B76A;
    font-size: 22rpx;
    font-weight: 700;
}

.finish-title {
    display: block;
    margin-top: 20rpx;
    font-size: 36rpx;
    font-weight: 700;
    color: #0F172A;
}

.finish-desc {
    display: block;
    margin-top: 12rpx;
    font-size: 26rpx;
    line-height: 1.5;
    color: #475569;
}

.finish-stats {
    display: flex;
    justify-content: space-around;
    margin: 30rpx 0;
    padding: 22rpx 12rpx;
    border-radius: 18rpx;
    background: #F8FAFC;
}

.finish-stat-val {
    display: block;
    font-size: 34rpx;
    font-weight: 700;
    color: #007AFF;
}

.finish-stat-lbl {
    display: block;
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #64748B;
}

.finish-actions {
    display: flex;
    gap: 18rpx;
}

.finish-btn {
    flex: 1;
}

/* AI 一键解析 */
.ai-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 22rpx;
}

.ai-btn {
    flex: 1;
    height: 70rpx;
    line-height: 70rpx;
    font-size: 24rpx;
    border-radius: 14rpx;
}

.ai-error {
    margin-top: 14rpx;
    padding: 14rpx 18rpx;
    border-radius: 12rpx;
    background: #FEF2F2;
    color: #DC2626;
    font-size: 23rpx;
}

.ai-box {
    margin-top: 18rpx;
    padding: 22rpx;
    border-radius: 16rpx;
    border: 2rpx solid #C7D2FE;
    background: #EEF2FF;
}

.ai-box-head {
    display: block;
    margin-bottom: 12rpx;
    color: #3730A3;
    font-size: 24rpx;
    font-weight: 700;
}

.ai-field + .ai-field {
    margin-top: 12rpx;
}

.ai-field-lbl {
    color: #1C1C1E;
    font-size: 24rpx;
    font-weight: 700;
}

.ai-field-val {
    color: #334155;
    font-size: 24rpx;
    line-height: 1.65;
}

.ai-mnemonic {
    margin-top: 14rpx;
    padding: 14rpx 18rpx;
    border-radius: 12rpx;
    background: rgba(255, 255, 255, 0.85);
}
