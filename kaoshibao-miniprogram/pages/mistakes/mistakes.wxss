.tab-bar {
    display: flex;
    padding: 8rpx;
    border-radius: 16rpx;
    background: #ffffff;
}

.tab-item {
    display: flex;
    flex: 1;
    height: 76rpx;
    align-items: center;
    justify-content: center;
    border-radius: 12rpx;
    color: #475569;
    font-size: 27rpx;
    font-weight: 600;
}

.tab-item-active {
    background: #F2F5FA;
    color: #2554A8;
    font-weight: 700;
}

.tab-count {
    margin-left: 8rpx;
    padding: 0 10rpx;
    border-radius: 999rpx;
    background: rgba(37, 84, 168, 0.12);
    font-size: 20rpx;
    font-variant-numeric: tabular-nums;
}

.list-bar {
    display: flex;
    align-items: center;
    margin: 28rpx 4rpx 18rpx;
}

.q-card {
    margin-bottom: 18rpx;
    padding: 26rpx;
}

.q-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}

.q-tag-gap {
    margin-left: 10rpx;
}

.q-stem {
    display: block;
    margin-top: 16rpx;
    color: #1E293B;
    font-size: 27rpx;
    font-weight: 600;
    line-height: 1.6;
}

.q-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18rpx;
    padding-top: 16rpx;
    border-top: 2rpx solid #F0F2F5;
}

.q-hint {
    color: #2554A8;
    font-size: 22rpx;
    font-weight: 600;
}

.q-arrow {
    color: #CBD5E1;
    font-size: 32rpx;
    line-height: 1;
}

.demo-tip {
    padding: 28rpx 0 8rpx;
    text-align: center;
}
