.detail-wrap {
    padding-bottom: 180rpx;
}

.bank-hero {
    padding: 30rpx 28rpx 26rpx;
    border-radius: 22rpx;
    background: linear-gradient(135deg, #F2F5FA 0%, #F6FAFF 60%, #E8F4FF 100%);
    border: 2rpx solid rgba(173, 214, 255, 0.6);
}

.bank-tag-gap {
    margin-left: 10rpx;
}

.bank-name {
    display: block;
    margin-top: 16rpx;
    color: #1E293B;
    font-size: 38rpx;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.5rpx;
}

.bank-desc {
    display: block;
    margin-top: 10rpx;
    color: #475569;
    font-size: 24rpx;
    line-height: 1.6;
}

.stat-row {
    display: flex;
    margin-top: 26rpx;
    padding: 20rpx 0;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.86);
}

.stat-cell {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    border-right: 2rpx solid #EDF3FB;
}

.stat-cell:last-child {
    border-right: none;
}

.stat-value {
    color: #1E293B;
    font-size: 36rpx;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
}

.stat-brand {
    color: #2554A8;
}

.stat-danger {
    color: #F56C6C;
}

.stat-success {
    color: #12B76A;
}

.stat-label {
    margin-top: 4rpx;
    color: #475569;
    font-size: 21rpx;
}

.hero-progress {
    margin-top: 22rpx;
    background: rgba(255, 255, 255, 0.9);
}

.hero-pct {
    display: block;
    margin-top: 10rpx;
    color: #475569;
    font-size: 22rpx;
}

.section-head {
    margin: 34rpx 4rpx 18rpx;
}

/* 模式卡 */
.mode-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -8rpx;
}

.mode-card {
    display: flex;
    width: calc(50% - 16rpx);
    align-items: center;
    margin: 0 8rpx 16rpx;
    padding: 24rpx 20rpx;
    border-radius: 18rpx;
    background: #ffffff;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.mode-icon {
    display: flex;
    width: 66rpx;
    height: 66rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 18rpx;
    font-size: 28rpx;
    font-weight: 700;
}

.tone-blue {
    background: #F2F5FA;
    color: #2554A8;
}

.tone-green {
    background: #ECFDF3;
    color: #12B76A;
}

.tone-amber {
    background: #FDF6EC;
    color: #E6A23C;
}

.tone-rose {
    background: #FEF0F0;
    color: #F56C6C;
}

.mode-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 16rpx;
    min-width: 0;
}

.mode-title {
    color: #1E293B;
    font-size: 26rpx;
    font-weight: 700;
}

.mode-desc {
    margin-top: 4rpx;
    color: #64748B;
    font-size: 20rpx;
    line-height: 1.4;
}

/* 题型 */
.type-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -8rpx;
}

.type-chip {
    display: flex;
    width: calc(33.33% - 16rpx);
    flex-direction: column;
    align-items: center;
    margin: 0 8rpx 16rpx;
    padding: 22rpx 0;
    border: 2rpx solid #E4E7ED;
    border-radius: 16rpx;
    background: #ffffff;
}

.type-name {
    color: #1E293B;
    font-size: 25rpx;
    font-weight: 600;
}

.type-count {
    margin-top: 4rpx;
    color: #64748B;
    font-size: 20rpx;
}

/* 章节 */
.chapter-card {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
    padding: 24rpx 26rpx;
}

.chapter-main {
    flex: 1;
    min-width: 0;
}

.chapter-title {
    display: block;
    color: #1E293B;
    font-size: 27rpx;
    font-weight: 600;
}

.chapter-meta {
    display: block;
    margin-top: 8rpx;
    color: #64748B;
    font-size: 22rpx;
}

.chapter-progress {
    margin-top: 12rpx;
    height: 8rpx;
}

.chapter-arrow {
    margin-left: 16rpx;
    color: #CBD5E1;
    font-size: 36rpx;
    line-height: 1;
}

/* 错题入口 */
.mistake-entry {
    display: flex;
    align-items: center;
    margin-top: 28rpx;
    border-left: 8rpx solid #F56C6C;
}

.mistake-title {
    display: block;
    color: #1E293B;
    font-size: 26rpx;
    font-weight: 700;
}

.mistake-desc {
    display: block;
    margin-top: 6rpx;
    color: #64748B;
    font-size: 21rpx;
}

.mistake-go {
    flex-shrink: 0;
    margin-left: 16rpx;
    color: #F56C6C;
    font-size: 24rpx;
    font-weight: 600;
}

.hero-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 22rpx;
}

.hero-tool-btn {
    padding: 10rpx 20rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.16);
    border: 1rpx solid rgba(255, 255, 255, 0.28);
    color: #ffffff;
    font-size: 22rpx;
    font-weight: 600;
    line-height: 1.4;
}

.hero-share-btn {
    margin: 0;
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
}

.qr-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
    background: rgba(15, 23, 42, 0.56);
}

.qr-dialog {
    width: 100%;
    padding: 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    text-align: center;
}

.qr-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.qr-close {
    font-size: 32rpx;
    color: #64748B;
    padding: 6rpx 10rpx;
}

.qr-title {
    display: block;
    margin-top: 12rpx;
    font-size: 28rpx;
    font-weight: 700;
    color: #1E293B;
}

.qr-loading {
    padding: 60rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.qr-img {
    width: 400rpx;
    height: 400rpx;
    margin: 24rpx auto 16rpx;
    border-radius: 16rpx;
    border: 2rpx solid #E4E7ED;
}

.qr-code-pill {
    display: inline-flex;
    align-items: center;
    gap: 12rpx;
    padding: 10rpx 22rpx;
    border-radius: 999rpx;
    background: #F2F5FA;
    color: #1E293B;
    font-size: 24rpx;
    font-weight: 600;
}

.qr-copy-tag {
    color: #2554A8;
    font-size: 22rpx;
}

.qr-tip {
    display: block;
    margin-top: 16rpx;
    color: #64748B;
    font-size: 22rpx;
    line-height: 1.5;
}

.qr-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 24rpx;
}

.qr-btn {
    flex: 1;
}

.self-dialog {
    width: 100%;
    max-height: 86vh;
    overflow-y: auto;
    padding: 30rpx;
    border-radius: 24rpx;
    background: #ffffff;
    text-align: left;
}

.self-sub {
    display: block;
    margin-top: 8rpx;
    color: #64748B;
    font-size: 22rpx;
}

.self-preset-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-top: 16rpx;
}

.self-preset-pill {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #F1F5F9;
    color: #334155;
    font-size: 22rpx;
    font-weight: 600;
}

.self-type-list {
    margin-top: 16rpx;
    display: flex;
    flex-direction: column;
    gap: 10rpx;
}

.self-type-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12rpx 16rpx;
    border-radius: 14rpx;
    background: #F8FAFC;
    border: 2rpx solid #E2E8F0;
}

.self-type-lbl {
    font-size: 24rpx;
    font-weight: 600;
    color: #1E293B;
}

.self-stepper {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.step-btn {
    width: 48rpx;
    height: 48rpx;
    line-height: 46rpx;
    text-align: center;
    border-radius: 10rpx;
    background: #ffffff;
    border: 2rpx solid #CBD5E1;
    color: #1E293B;
    font-size: 28rpx;
    font-weight: 700;
}

.step-input {
    width: 72rpx;
    height: 48rpx;
    text-align: center;
    border-radius: 10rpx;
    background: #ffffff;
    border: 2rpx solid #CBD5E1;
    font-size: 25rpx;
    font-weight: 700;
    color: #2554A8;
}

.self-option-row {
    margin-top: 16rpx;
}

.self-opt-lbl {
    display: block;
    font-size: 22rpx;
    font-weight: 600;
    color: #475569;
    margin-bottom: 8rpx;
}

.self-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
}

.self-opt-pill {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #F1F5F9;
    color: #475569;
    font-size: 22rpx;
}

.self-opt-active {
    background: #2554A8;
    color: #ffffff;
    font-weight: 600;
}
