.dash-page {
    padding: 24rpx 32rpx 56rpx;
}

/* 1. 极简问候语 */
.greet-line {
    display: block;
    margin-bottom: 24rpx;
    color: #636366;
    font-size: 27rpx;
    font-weight: 500;
}

/* 2. Hero 主焦点卡片 */
.hero-card {
    padding: 36rpx 34rpx 32rpx;
    border-radius: 40rpx;
    background: #FFFFFF;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.035);
}

.hero-pct {
    color: #007AFF;
    font-size: 26rpx;
    font-weight: 700;
}

.hero-title {
    display: block;
    margin-top: 18rpx;
    color: #1C1C1E;
    font-size: 38rpx;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.4rpx;
}

.hero-sub {
    display: block;
    margin-top: 8rpx;
    color: #636366;
    font-size: 25rpx;
}

.hero-progress {
    margin-top: 22rpx;
    height: 10rpx;
    background: #F2F2F7;
}

.hero-cta {
    margin-top: 28rpx;
    height: 88rpx;
    border-radius: 22rpx;
    font-size: 30rpx;
    font-weight: 700;
}

.hero-sub-actions {
    display: flex;
    gap: 18rpx;
    margin-top: 18rpx;
}

.hero-sub-btn {
    flex: 1;
    height: 76rpx;
    border-color: #E5E5EA;
    border-radius: 20rpx;
    color: #1C1C1E;
    font-size: 27rpx;
    font-weight: 600;
}

/* 3. Apple 极简 3 项统计条 */
.stat-strip {
    display: flex;
    align-items: center;
    margin-top: 28rpx;
    padding: 28rpx 12rpx;
    border-radius: 36rpx;
}

.stat-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
}

.stat-sep {
    width: 2rpx;
    height: 52rpx;
    background: #E5E5EA;
}

.stat-num {
    color: #1C1C1E;
    font-size: 40rpx;
    font-weight: 800;
    line-height: 1.2;
}

.stat-num-brand {
    color: #007AFF;
}

.stat-num-danger {
    color: #FF3B30;
}

.stat-lbl {
    margin-top: 8rpx;
    color: #636366;
    font-size: 22rpx;
}

/* 4. iOS Grouped 分组列表 */
.section-block {
    margin-top: 32rpx;
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 10rpx 14rpx;
}

.section-title {
    color: #8E8E93;
    font-size: 24rpx;
    font-weight: 600;
}

.section-more {
    color: #007AFF;
    font-size: 24rpx;
    font-weight: 600;
}

.grouped-card {
    padding: 8rpx 32rpx;
    border-radius: 36rpx;
}

.grouped-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0;
}

.grouped-row + .grouped-row {
    border-top: 1rpx solid #E5E5EA;
}

.grouped-main {
    flex: 1;
    min-width: 0;
    padding-right: 20rpx;
}

.grouped-title {
    display: block;
    color: #1C1C1E;
    font-size: 29rpx;
    font-weight: 600;
}

.grouped-meta {
    display: block;
    margin-top: 6rpx;
    color: #636366;
    font-size: 23rpx;
}

.play-circle {
    display: flex;
    flex-shrink: 0;
    width: 64rpx;
    height: 64rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #EAF3FF;
    color: #007AFF;
    font-size: 24rpx;
}

/* 5. 紧凑单行考场码卡片 */
.join-card {
    margin-top: 28rpx;
    padding: 20rpx 24rpx;
    border-radius: 32rpx;
}

.join-row {
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.join-input {
    flex: 1;
    min-width: 0;
    height: 76rpx;
    padding: 0 24rpx;
    border-radius: 22rpx;
    background: #F2F2F7;
    color: #1C1C1E;
    font-size: 26rpx;
    letter-spacing: 1rpx;
}

.join-btn {
    flex-shrink: 0;
    width: 140rpx !important;
    height: 76rpx;
    border-radius: 22rpx;
    font-size: 27rpx;
    font-weight: 700;
}

/* 6. 公共题库行 */
.public-title {
    margin-left: 12rpx;
    color: #1C1C1E;
    font-size: 28rpx;
    font-weight: 600;
}

.public-btn {
    flex-shrink: 0;
    border-color: #CCE3FF;
    background: #EAF3FF;
    color: #007AFF;
}

.empty-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 56rpx 32rpx;
    text-align: center;
}

.ph {
    color: #8E8E93;
}
