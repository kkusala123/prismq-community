# 对外映射端口（宿主机端口）
APP_PORT=3000

# 公网访问地址与 CORS 白名单（上线域名时请务必填写完整 URL/Origin，多域名用英文逗号分隔）
PUBLIC_URL=https://prismq.example.com
CORS_ORIGINS=https://prismq.example.com
# 反代层级（OpenResty/Nginx 在前时保持 1，便于正确识别 HTTPS 与客户端真实 IP）
TRUST_PROXY=1
# 生产环境建议保持 false，避免自动创建演示账号与题库
SEED_DEMO_DATA=false

# PostgreSQL 数据库配置
POSTGRES_USER=kaoshibao
POSTGRES_PASSWORD=please_change_postgres_password
POSTGRES_DB=kaoshibao

# JWT 登录签名密钥（生产环境请改为 32 位以上随机字符串）
JWT_SECRET=please_change_jwt_secret_key

# 全局 AI API 配置（仅系统管理员可见与管理；也可部署后在管理员「设置」页配置）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 微信小程序「一键登录」（留空则不启用，登录面板会隐藏微信入口）
# AppID 必须与小程序后台一致；AppSecret 只在服务端使用，切勿写入前端或提交到仓库
WECHAT_APPID=
WECHAT_APPSECRET=

# Android APK 自动更新（支持管理员上传自托管 APK，也可选填你自己的 GitHub Releases 仓库）
GITHUB_REPO=
# 私有仓库需填写具备 Contents: read 权限的 GitHub Token
GITHUB_TOKEN=
APP_UPDATE_POLL_INTERVAL_MINUTES=15
