# 对外映射端口（宿主机端口）
APP_PORT=3000

# 公网访问地址与 CORS 白名单（上线域名时请填写完整 URL/Origin，多域名用英文逗号分隔）
PUBLIC_URL=https://prismq.example.com
CORS_ORIGINS=https://prismq.example.com
# 反代层级（OpenResty/Nginx 在前时保持 1，便于正确识别 HTTPS 与客户端真实 IP）
TRUST_PROXY=1
# 生产环境建议保持 false，避免自动创建演示账号与题库
SEED_DEMO_DATA=false

# PostgreSQL 数据库配置
POSTGRES_USER=kaoshibao
POSTGRES_PASSWORD=please_change_postgres_password
POSTGRES_DB=kaoshibao

# JWT 登录签名密钥（生产环境请改为 32 位以上随机字符串）
JWT_SECRET=please_change_jwt_secret_key

# 全局 AI API 配置（仅系统管理员可见与管理；也可部署后在管理员「设置」页配置）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 【可选功能】Android APK 自动更新推送（默认关闭；如需开启请设置 APP_UPDATE_ENABLED=true 并填写您自己的 GitHub Release 仓库）
APP_UPDATE_ENABLED=false
GITHUB_REPO=
# 若您的 Release 仓库为私有仓库，请填写具备只读 Contents 权限的 GitHub Token；公开仓库可留空
GITHUB_TOKEN=
APP_UPDATE_POLL_INTERVAL_MINUTES=15
